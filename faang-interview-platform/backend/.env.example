# ── Anthropic ─────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── MongoDB ────────────────────────────────────────────
# Free tier: https://cloud.mongodb.com  (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/faang_interview

# ── JWT ───────────────────────────────────────────────
# Any long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-64-chars

# ── Razorpay ──────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── App ───────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://yourdomain.com
NODE_ENV=production

# ── Subscription ──────────────────────────────────────
# Price in paise (₹2000 = 200000 paise)
SUBSCRIPTION_PRICE_PAISE=200000
SUBSCRIPTION_NAME=FAANG Interview Pro

